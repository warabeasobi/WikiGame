{
  "name": "Wikipedia Speedrun",
  "short_name": "Speedrun",
  "description": "A Wikipedia navigation puzzle game: reach the target article using only hyperlinks. 7 modes, daily challenge, achievements, statistics.",
  "id": "wikipedia-speedrun",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#f6f7fb",
  "theme_color": "#4c8dff",
  "categories": ["games", "education", "entertainment"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-180.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "icons/screenshot-wide.svg", "sizes": "1280x720", "type": "image/svg+xml", "form_factor": "wide" },
    { "src": "icons/screenshot-narrow.svg", "sizes": "720x1280", "type": "image/svg+xml", "form_factor": "narrow" }
  ],
  "shortcuts": [
    { "name": "Quick play", "short_name": "Quick", "url": "./#/play", "description": "Jump straight into a random run" },
    { "name": "Daily challenge", "short_name": "Daily", "url": "./#/daily", "description": "Today's puzzle" },
    { "name": "Statistics", "short_name": "Stats", "url": "./#/stats" }
  ]
}
