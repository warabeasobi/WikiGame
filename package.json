{
  "name": "wikirace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WikiRace - a Wikipedia link navigation race, built with React, Vite and TypeScript",
  "scripts": {
    "dev": "vite",
    "serve": "vite --port 8080 --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "pages": "pnpm build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
